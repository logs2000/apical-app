# Apical docker-compose configuration.
#   cp .env.docker.example .env.docker && edit
#   docker compose --env-file .env.docker up -d
#
# Generate each secret with:  openssl rand -base64 32

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
APICAL_VAULT_KEY=
APICAL_RELAY_SECRET=
APICAL_SCHEDULER_SECRET=
APICAL_BRIDGE_SECRET=
AGENT_WORKER_SECRET=

# --- Web authentication -----------------------------------------------------
# Hosted (multi-user): create a Supabase project and fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Self-hosted single-user alternative: set DESKTOP_LOCAL=true to use the local
# credentials auth path instead of Supabase (leave the three vars above empty).
DESKTOP_LOCAL=false

# --- LLM providers (set at least one so agents can answer) -------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# Optional: which configured provider to prefer for the default model.
LLM_DEFAULT_PROVIDER=

# --- Optional ----------------------------------------------------------------
POSTGRES_DB=apical
APICAL_HTTP_PORT=8080
# Public origin of this deployment, e.g. https://apical.example.com
# (used for desktop-bridge CORS).
APICAL_PUBLIC_ORIGIN=
SMTP_URI=
STRIPE_SECRET_KEY=
