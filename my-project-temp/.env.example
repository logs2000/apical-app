# Apical — environment variables.
# Copy to .env.local for local dev, or set these in the Vercel dashboard.
# NEVER commit real secrets. Only this example file is tracked.

# ----------------------------------------------------------------------------
# Required (production)
# ----------------------------------------------------------------------------

# Postgres runtime connection — Supabase Transaction pooler (port 6543):
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Direct/session connection for migrations & `prisma db push` (port 5432):
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Supabase Auth (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Pre-launch passcode gate. When set, visitors must enter this passcode once
# per browser before they can see the app. Leave empty to disable the gate.
PRELAUNCH_PASSCODE=

# AES-256-GCM key for the credential/PAT vault. Use a random 32+ char string.
# REQUIRED in production — the app fails closed without it.
APICAL_VAULT_KEY=

# ─── Pipedream Connect (primary managed connection path) ────────────────────
# Apical's primary way to connect third-party apps (3,000+ app catalog).
# Create a Connect project at https://pipedream.com → Projects → Connect, then
# copy the project id and an OAuth client id/secret here. Leave ALL of these
# empty to disable the managed path entirely — direct OAuth/MCP/OpenAPI
# connections keep working unchanged (the self-hosted / local-first mode).
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
# "development" (free tier, separate credential store) or "production".
PIPEDREAM_PROJECT_ENVIRONMENT=development
# Optional: shared token appended to the Connect webhook URL (?token=...) so
# /api/pipedream/webhook can reject spoofed CONNECTION_* events.
PIPEDREAM_WEBHOOK_SECRET=
# Optional comma-separated origins allowed to use Connect tokens in the
# browser. Defaults to the app URL derived from NEXTAUTH_URL.
PIPEDREAM_ALLOWED_ORIGINS=

# Shared secret between the scheduler mini-service and the Next.js API
# (X-Scheduler-Secret header). Use a random 32+ char string and set the SAME
# value on both. Scheduler auth fails closed when unset — scheduled runs and
# the OAuth refresh cron will not fire.
APICAL_SCHEDULER_SECRET=

# Shared secret the Next.js app uses to publish run events to the run-relay
# (X-Relay-Secret header). Set the SAME value on the relay service. When
# unset, the relay refuses publishes (fails closed).
APICAL_RELAY_SECRET=

# ----------------------------------------------------------------------------
# Local development auto sign-in (dev only — ignored when NODE_ENV=production).
# ----------------------------------------------------------------------------
# When DEV_AUTH_EMAIL is set, `next dev` auto signs-in as this account (no login
# screen) using a REAL, data-scoped User row that's created on first use. Leave
# empty to require a normal login. This is NOT a production bypass — it never
# runs in a production build. Matches the seed account by default.
DEV_AUTH_EMAIL=dev@apical.local
DEV_AUTH_PASSWORD=apical-dev
DEV_AUTH_NAME=Developer

# Platform operator emails (comma-separated). Required for /api/admin/* routes.
APICAL_ADMIN_EMAILS=dev@apical.local

# Optional global token allowance multiplier when no DB override exists (default 1).
# APICAL_TOKEN_ALLOWANCE_MULTIPLIER=1

# ----------------------------------------------------------------------------
# AI models (at least one provider needed for agents to respond)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
GOOGLE_API_KEY=
XAI_API_KEY=
# LLM_DEFAULT_PROVIDER=

# ----------------------------------------------------------------------------
# Optional — Google OAuth (web login button). Configure the redirect in
# Supabase Auth -> Providers -> Google, not here.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Optional — Stripe billing (demo mode works without these)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PERSONAL=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_ENTERPRISE=
# BILLING_DEMO_MODE=

# ----------------------------------------------------------------------------
# Optional — email (password reset / notifications). Empty = log-only.
# ----------------------------------------------------------------------------
SMTP_URI=
NOTIFICATIONS_FROM_EMAIL=

# ----------------------------------------------------------------------------
# Desktop / NextAuth legacy (only used by the Tauri desktop build locally)
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=
