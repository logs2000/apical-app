{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    // The dev/CI harness (smoke scripts, unit tests) and the bun mini-services
    // are NOT part of the web app build. Excluding a dir doesn't stop tsc from
    // following imports into it — the smoke scripts import mini-services code,
    // whose deps (playwright) only exist in per-service node_modules — so
    // `next build`'s type check must not start from them. CI type-checks the
    // full tree via tsconfig.ci.json, where those deps are installed.
    "mini-services",
    "scripts",
    "tests"
  ]
}
